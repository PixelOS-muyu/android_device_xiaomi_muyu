on property:sys.boot_completed=1
    chown system system /dev/nanodev0
    chmod 0660 /dev/nanodev0
    chown system system /sys/devices/virtual/nanodev/nanodev0/_version176x
    chmod 0440 /sys/devices/virtual/nanodev/nanodev0/_version176x
    chown system system /sys/bus/hid/drivers/hid-generic/bind
    chown system system /sys/bus/hid/drivers/hid-generic/unbind
    start vendor.midevauth
    start vendor.xiaomi-keyboard

service vendor.xiaomi-keyboard /vendor/bin/xiaomi-keyboard
    class hal
    user system
    group system input
    disabled
