type xiaomi_keyboard, domain;
type xiaomi_keyboard_exec, exec_type, vendor_file_type, file_type;

init_daemon_domain(xiaomi_keyboard)

# MiDevAuth HAL
binder_use(xiaomi_keyboard)
hal_client_domain(xiaomi_keyboard, hal_midevauth)

# Keyboard MCU
allow xiaomi_keyboard nano_device:chr_file rw_file_perms;
allow xiaomi_keyboard sysfs_nanodev:dir search;
allow xiaomi_keyboard sysfs_nanodev:file r_file_perms;

# HID bind / unbind
allow xiaomi_keyboard sysfs_xiaomi_kbd_hid:dir r_dir_perms;
allow xiaomi_keyboard sysfs_xiaomi_kbd_hid:lnk_file r_file_perms;
allow xiaomi_keyboard sysfs_xiaomi_kbd_hid:file rw_file_perms;

# Caps Lock / backlight hotkeys
allow xiaomi_keyboard input_device:dir r_dir_perms;
allow xiaomi_keyboard input_device:chr_file r_file_perms;

allow xiaomi_keyboard sysfs:dir r_dir_perms;
allow xiaomi_keyboard sysfs:lnk_file read;

# Adaptive backlight level from XiaomiParts
get_prop(xiaomi_keyboard, xiaomi_kbd_backlight_prop)
